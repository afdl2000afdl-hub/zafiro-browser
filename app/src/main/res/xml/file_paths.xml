<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- 相机输出：临时写进 cache/capture，ingest 完成（或失败）后由 VM 删掉。
         用 FileProvider 而不是 MediaStore：刚 insert 的 MediaStore 记录是 IS_PENDING=1，
         pending 项对非所有者是 owner-only，相机（另一个 uid）写不进去。 -->
    <cache-path
        name="camera_capture"
        path="capture/" />

    <!-- IAB 文件上传：源文件（filesDir/cacheDir 内）复制到 cache/iab_upload 后授予 WebView 内核读取 -->
    <cache-path
        name="iab_upload"
        path="iab_upload/" />

    <!-- IAB 下载捕获：onDownloadStart 落盘到 filesDir/downloads，agent 与用户都可读取 -->
    <files-path
        name="iab_downloads"
        path="downloads/" />
</paths>
